# Copy to .env.local and fill in.
# Where Next proxies /api (server-side only). The browser always calls /api on the web's own origin.
AGENT_API_ORIGIN='http://localhost:8811'
# MaintenanceVault address after deploy (empty = contract not deployed, rules run off-chain)
NEXT_PUBLIC_VAULT_ADDRESS=''
# 763373 = Ink Sepolia · 11155111 = Ethereum Sepolia
NEXT_PUBLIC_CHAIN_ID='763373'
